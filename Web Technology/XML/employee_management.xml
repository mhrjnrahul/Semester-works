<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Employees [
  <!ELEMENT Employees (Employee+)>
  <!ELEMENT Employee (Name, Position, Department, Salary, ContactDetails)>
  <!ATTLIST Employee id CDATA #REQUIRED>
  
  <!ELEMENT Name (#PCDATA)>
  <!ELEMENT Position (#PCDATA)>
  <!ELEMENT Department (#PCDATA)>
  <!ELEMENT Salary (#PCDATA)>
  <!ATTLIST Salary currency CDATA #IMPLIED>
  
  <!ELEMENT ContactDetails (Email, Phone)>
  <!ELEMENT Email (#PCDATA)>
  <!ELEMENT Phone (#PCDATA)>
]>

<Employees>
  <Employee id="E101">
    <Name>John Doe</Name>
    <Position>Software Engineer</Position>
    <Department>Development</Department>
    <Salary currency="USD">65000</Salary>
    <ContactDetails>
      <Email>john.doe@example.com</Email>
      <Phone>1234567890</Phone>
    </ContactDetails>
  </Employee>

  <Employee id="E102">
    <Name>Jane Smith</Name>
    <Position>Project Manager</Position>
    <Department>Management</Department>
    <Salary>80000</Salary> <!-- currency omitted (optional) -->
    <ContactDetails>
      <Email>jane.smith@example.com</Email>
      <Phone>0987654321</Phone>
    </ContactDetails>
  </Employee>
</Employees>
